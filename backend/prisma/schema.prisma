generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  users            User[]
  inventory        Inventory[]
  purchaseOrders   PurchaseOrder[]
  salesTransactions SalesTransaction[]

  @@map("stores")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  storeId      String?   @map("store_id") @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         String    @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at")

  store              Store?               @relation(fields: [storeId], references: [id])
  salesTransactions  SalesTransaction[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique
  name        String
  description String?
  category    String?
  price       Decimal  @db.Decimal(12, 2)
  cost        Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  inventory              Inventory[]
  purchaseOrderItems     PurchaseOrderItem[]
  salesTransactionItems  SalesTransactionItem[]

  @@map("products")
}

model Inventory {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  quantity     Int      @default(0)
  reorderPoint Int      @default(0) @map("reorder_point")
  updatedAt    DateTime @default(now()) @map("updated_at")

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
  @@map("inventory")
}

model PurchaseOrder {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  supplier  String?
  status    String   @default("draft") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  store  Store               @relation(fields: [storeId], references: [id])
  items  PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  quantity        Int
  unitCost        Decimal @map("unit_cost") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model SalesTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  cashierId     String   @map("cashier_id") @db.Uuid
  total         Decimal  @db.Decimal(12, 2)
  paymentMethod String?  @map("payment_method") @db.VarChar(50)
  status        String   @default("completed") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  store    Store                  @relation(fields: [storeId], references: [id])
  cashier  User                   @relation(fields: [cashierId], references: [id])
  items    SalesTransactionItem[]

  @@map("sales_transactions")
}

model SalesTransactionItem {
  id            String  @id @default(uuid()) @db.Uuid
  transactionId String  @map("transaction_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(12, 2)

  transaction SalesTransaction @relation(fields: [transactionId], references: [id])
  product     Product          @relation(fields: [productId], references: [id])

  @@map("sales_transaction_items")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("audit_log")
}
